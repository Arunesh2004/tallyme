# ══════════════════════════════════════════════════════════════════════════════
# TallyMe Backend — Environment Configuration Template
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env — it is listed in .gitignore.
# ══════════════════════════════════════════════════════════════════════════════

# Application
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=
DATABASE_SSL=false

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Security ─────────────────────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET=
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
JWT_CLOCK_TOLERANCE=30
JWT_ISSUER=tallyme
JWT_AUDIENCE=tallyme-app
SECURITY_BCRYPT_ROUNDS=12

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Mail Integration (Gmail OAuth2) ─────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=
MAIL_STORAGE_PATH=./storage/attachments
MAIL_POLL_INTERVAL_MS=60000

# ── AI Services ──────────────────────────────────────────────────────────────
# Gemini / Google Vision
AI_PROVIDER=gemini
AI_MODEL=models/gemini-flash-lite-latest
AI_API_KEY=
GOOGLE_VISION_API_KEY=

# Azure Cognitive Services (OCR — optional fallback)
AZURE_OCR_ENDPOINT=
AZURE_OCR_KEY=

# ── Tally Prime Integration ───────────────────────────────────────────────────
# Tally Prime runs as an HTTP server on the local machine
TALLY_HOST=localhost
TALLY_PORT=9000
TALLY_TIMEOUT_MS=30000
# Leave blank — the backend discovers the active company from Tally Prime at runtime
TALLY_COMPANY_NAME=

# ── ERP Sync ─────────────────────────────────────────────────────────────────
ERP_SYNC_INTERVAL_MS=30000

# ── Support ──────────────────────────────────────────────────────────────────
TALLYME_SUPPORT_EMAIL=
