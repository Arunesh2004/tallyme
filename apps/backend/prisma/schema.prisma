  id             String   @id @default(uuid())
  organizationId String?
  eventType      String // API_ERROR, AGENT_CRASH, SYNC_FAILURE, SECURITY_EVENT, BILLING_EVENT
  severity       String // INFO, WARNING, ERROR, CRITICAL
