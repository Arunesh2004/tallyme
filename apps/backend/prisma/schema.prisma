model AccountingAgent {
  id        String   @id @default(uuid())
  name      String
  agentType String   @unique // VENDOR_RESOLUTION, LEDGER_REPAIR, RECONCILIATION, SYNC_RECOVERY
  status    String // ACTIVE, DISABLED
  version   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions AgentExecution[]
  rules      AgentRule[]
}

model AgentExecution {
  id             String          @id @default(uuid())
  agentId        String
  agent          AccountingAgent @relation(fields: [agentId], references: [id])
  organizationId String?
  companyId      String?
  triggerType    String // EXCEPTION, SYNC_FAILURE, VALIDATION_FAILURE
  inputContext   Json?
  decision       Json?
  confidence     Float?
  status         String // PENDING_APPROVAL, APPROVED, REJECTED, EXECUTED
  createdAt      DateTime        @default(now())

  feedbacks AgentFeedback[]
}

model AccountingRecommendation {
  id                 String   @id @default(uuid())
  exceptionId        String?
  recommendationType String // e.g., CREATE_LEDGER, MERGE_VENDOR, CORRECT_TAX
  beforeState        Json?
  afterState         Json?
  reason             String?  @db.Text
  confidence         Float
  status             String   @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED, EXECUTING, COMPLETED, FAILED
  createdAt          DateTime @default(now())

  evidences AgentDecisionEvidence[]
}

model AgentDecisionEvidence {
  id               String                   @id @default(uuid())
  recommendationId String
  recommendation   AccountingRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  source           String // e.g., TALLY_MAPPING, VENDOR_HISTORY, RECONCILIATION
  evidenceData     Json
  createdAt        DateTime                 @default(now())
}

model AgentFeedback {
  id           String         @id @default(uuid())
  executionId  String
  execution    AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  approved     Boolean
  rejected     Boolean
  humanComment String?        @db.Text
  createdAt    DateTime       @default(now())
}

model AgentRule {
  id        String          @id @default(uuid())
  agentId   String
  agent     AccountingAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  ruleName  String
  condition Json
  action    Json
  priority  Int             @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
}

