}

model UsageMetric {
  id             String   @id @default(uuid())
  organizationId String
  metricName     String // INVOICES_PROCESSED, STUDENTS_PROCESSED, TALLY_SYNC_COUNT, AI_RECOMMENDATIONS
  value          Int      @default(0)
  period         String // YYYY-MM
  createdAt      DateTime @default(now())
}

model FeatureFlag {
  id             String   @id @default(uuid())
  featureName    String // AI_AGENTS_ENABLED, TALLY_SYNC_ENABLED, MULTI_COMPANY_ENABLED
