  previousValue         Float
  currentValue          Float
  trend                 String // IMPROVING, DECLINING, STABLE
  totalRecommendations  Int      @default(0)
  approvedCount         Int      @default(0)
  rejectedCount         Int      @default(0)
  executionSuccessCount Int      @default(0)
  rollbackCount         Int      @default(0)
  accuracyScore         Float    @default(0)
