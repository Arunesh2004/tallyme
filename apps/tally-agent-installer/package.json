{
  "name": "tallyme-agent-installer",
  "version": "1.0.0",
  "description": "Windows Service Installer for TallyMe Agent",
  "scripts": {
    "build:exe": "pkg . --targets node18-win-x64 --output dist/TallyMe-Agent.exe",
    "service:install": "node scripts/install-service.js",
    "service:uninstall": "node scripts/uninstall-service.js"
  },
  "dependencies": {
    "node-windows": "^1.0.0-beta.8",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
