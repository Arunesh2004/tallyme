}

model TallyGroupSnapshot {
  id              String   @id @default(uuid())
  scanId          String?
  groupName       String?
}

model TallyStructureScan {
  id              String   @id @default(uuid())
}

model SyncVerification {
  id              String   @id @default(uuid())
  syncId          String?
