# ==============================================================================
# TALLYME ENTERPRISE - PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Rename this file to `.env` before deploying with docker-compose.prod.yml
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE APPLICATION
# ------------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
IMAGE_TAG=latest

# ------------------------------------------------------------------------------
# SECURITY (REQUIRED SECRETS)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_replace_me
JWT_EXPIRY=1h
ENCRYPTION_KEY=super_secret_encryption_key_replace_me
CORS_ORIGINS=https://app.yourdomain.com
WEBHOOK_SECRET=your_stripe_or_external_webhook_secret

# ------------------------------------------------------------------------------
# DATABASE & CACHE
# ------------------------------------------------------------------------------
POSTGRES_USER=tallyme
POSTGRES_PASSWORD=secure_postgres_password_replace_me
POSTGRES_DB=tallyme_prod
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secure_redis_password_replace_me

# ------------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS (REQUIRED PHYSICAL INFRASTRUCTURE / CREDENTIALS)
# ------------------------------------------------------------------------------

# --- Email / SMTP ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCOUNT=

# --- Artificial Intelligence ---
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4

# --- OCR Integration ---
AZURE_OCR_KEY=

# --- Tally Prime Network ---
ERP_HOST=host.docker.internal
ERP_PORT=9000
ERP_COMPANY_NAME=

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/v1

# ------------------------------------------------------------------------------
# MONITORING & LOGGING
# ------------------------------------------------------------------------------
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=secure_grafana_password_replace_me
GRAFANA_URL=http://localhost:3002
